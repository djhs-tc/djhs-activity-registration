{
  "name": "activity",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "djhs-activity-db",
    "database_id": "398040fe-bbc4-4ad1-b4cf-41c4a325c4ac"
  }],
  // GOOGLE_CLIENT_ID、SESSION_SECRET、ADMIN_EMAILS 以 Cloudflare Secret 設定（勿在此重複宣告，
  // 否則部署會因 binding 名稱衝突失敗）。三者任一缺少時，登入功能自動停用。
  "vars": {
    "ALLOWED_EMAIL_DOMAINS": "st.tc.edu.tw,tjjh.tc.edu.tw"
  }
}
